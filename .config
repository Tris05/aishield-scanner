# ==============================================================================
# AIShield Security Scanner Configuration (.config)
# Place this file in the root of your target repository to configure scan options.
# If omitted from the target repository, AIShield defaults to this fallback file.
# ==============================================================================

# Severity gate threshold to fail the job
# Options: critical, high, medium, low, info, none (default: none)
AISECURITY_FAIL_ON=none

# Gate policy for coverage completeness (true / false)
AISECURITY_FAIL_ON_COVERAGE=false

# Report output directory (default: aishield-reports)
AISECURITY_REPORT_DIR=aishield-reports

# Scanner orchestration concurrency limit (1 to 8)
AISECURITY_MAX_PARALLEL_SCANNERS=4

# Timeout per stage in seconds (default: 1800)
AISECURITY_STAGE_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# Dependency & Supply Chain Analysis
# ------------------------------------------------------------------------------
# Compare exact-pinned dependencies with latest registry versions (true / false)
AISECURITY_CHECK_VERSION_FRESHNESS=false

# Opt in to npm audit for Node.js projects (true / false)
AISECURITY_ENABLE_NPM_AUDIT=false

# ------------------------------------------------------------------------------
# Runtime LLM Red Teaming & Canary Testing
# ------------------------------------------------------------------------------
# Opt in to bounded runtime tests against an authorized test endpoint
AISECURITY_AUTHORIZED=false

# Engine selection: custom (authorized app endpoint) or garak (model generator)
AISECURITY_LLM_REDTEAM_MODE=custom

# For 'custom' mode: authorized staging URL and exact hostname allowlist
AISECURITY_TARGET_URL=
AISECURITY_ALLOWED_HOSTS=
AISECURITY_ALLOW_PRIVATE_TARGET=false
AISECURITY_REQUEST_FIELD=input
AISECURITY_MAX_REDTEAM_REQUESTS=2
AISECURITY_CANARY=

# For 'garak' mode: generator type, model, and probes
AISECURITY_GARAK_TARGET_TYPE=openai
AISECURITY_GARAK_TARGET_NAME=gpt-4o-mini
AISECURITY_GARAK_BASE_URL=
AISECURITY_GARAK_ALLOWED_HOSTS=
AISECURITY_GARAK_ALLOW_PRIVATE_TARGET=false
AISECURITY_GARAK_PROBES=probes.promptinject,probes.encoding
AISECURITY_GARAK_GENERATIONS=1

# ------------------------------------------------------------------------------
# Web & API Dynamic Analysis (OWASP ZAP Baseline DAST)
# ------------------------------------------------------------------------------
AISECURITY_ENABLE_DAST=false
AISECURITY_DAST_TARGET_URL=
AISECURITY_DAST_ALLOWED_HOSTS=
AISECURITY_DAST_ALLOW_PRIVATE_TARGET=false

# ------------------------------------------------------------------------------
# Repository Intake & Git Host Allowlist
# ------------------------------------------------------------------------------
AISECURITY_GIT_ALLOWED_HOSTS=github.com,gitlab.com
AISECURITY_ALLOW_PRIVATE_GIT_HOST=false
