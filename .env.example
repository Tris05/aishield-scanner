# Scanner runs from GitLab CI. Add the following as masked/protected CI/CD variables.
AISECURITY_DASHBOARD_URL=https://your-dashboard-api.example.com
AISECURITY_UPLOAD_TOKEN=replace-with-the-backend-ingest-token

# Optional scan behavior (normally use target repo .config instead).
AISECURITY_FAIL_ON=none
AISECURITY_FAIL_ON_COVERAGE=false
AISECURITY_MAX_PARALLEL_SCANNERS=4
AISECURITY_STAGE_TIMEOUT_SECONDS=1800
